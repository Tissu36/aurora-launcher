{
  "name": "aurora-launcher",
  "version": "1.0.0",
  "description": "Aurora · Chapter 5 Season 1 launcher. Made by Whykrushy · Aur Krushy",
  "author": "Whykrushy (Aur Krushy)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.whykrushy.aurora",
    "productName": "Aurora Launcher",
    "files": ["main.js", "preload.js", "src/**/*"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Aurora" }
  }
}
